{
  "name": "@commission-index/web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "fact-source:export": "FACT_SOURCE_WRANGLER_CONFIG=../web/wrangler.jsonc bun run --cwd ../admin-worker web:fact-source:export",
    "fact-source:sync-images": "FACT_SOURCE_WRANGLER_CONFIG=../web/wrangler.jsonc bun run --cwd ../admin-worker web:fact-source:sync-images",
    "build:astro": "astro build",
    "check:astro": "astro check .",
    "dev": "bun run fact-source:sync-images && NODE_ENV=development astro dev",
    "build": "astro build",
    "check": "astro check .",
    "preview": "bun run fact-source:export && astro build --clean && astro preview",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun run --cwd ../.. test",
    "test:changed": "bun run --cwd ../.. test:changed",
    "test:watch": "bun run --cwd ../.. test:watch",
    "test:visual": "bun run --cwd ../.. test:visual",
    "test:visual:update": "bun run --cwd ../.. test:visual:update"
  },
  "dependencies": {
    "@commission-index/domain": "workspace:*",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@testing-library/jest-dom": "^6.9.1",
    "astro": "^6.1.1",
    "jsdom": "^29.0.1",
    "sharp": "^0.34.5"
  },
  "overrides": {
    "vite": "^8.0.3"
  }
}
