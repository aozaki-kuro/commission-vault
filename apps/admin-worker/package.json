{
  "name": "@commission-index/admin-worker",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "dev:remote": "wrangler dev --config wrangler.jsonc",
    "d1:migrate": "wrangler d1 migrations apply DB --config wrangler.jsonc --remote",
    "d1:seed:sql": "mkdir -p ./.wrangler/tmp && bun run ./scripts/buildD1SeedSql.mjs ./.wrangler/tmp/admin-seed.sql",
    "d1:seed": "bun run d1:seed:sql && wrangler d1 execute DB --config wrangler.jsonc --remote --file ./.wrangler/tmp/admin-seed.sql",
    "web:fact-source:export": "bun run ./scripts/exportWebFactSource.mjs",
    "r2:sync": "bun run ./scripts/syncImagesToR2.mjs",
    "data:check": "bun run ./scripts/checkFactSourceParity.mjs",
    "data:bootstrap": "bun run d1:migrate && bun run d1:seed && bun run r2:sync",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.74.0"
  }
}
