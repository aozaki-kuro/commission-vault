{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "commission-index-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-17",
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "preview_urls": false,
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commission-index-admin-data",
      "database_id": "c448328b-830b-455a-ab90-06a9cf95d8aa",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "commission-index-source-images"
    }
  ],
  "routes": [
    {
      "pattern": "admin.crystallize.cc",
      "custom_domain": true
    }
  ],
  // `database_id` / preview/prod split can be filled by Wrangler auto-provisioning or explicit Cloudflare resource IDs later.
  "vars": {
    "ADMIN_REALM": "admin.crystallize.cc",
    "LEGACY_ADMIN_API_BASE_URL": "http://localhost:4321"
  }
}
