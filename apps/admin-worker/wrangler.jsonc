{
  // Build command invoked by `wrangler deploy --config apps/admin-worker/wrangler.jsonc`:
  // `bun run build:admin:cf`
  // Repo-root deploy command:
  // `bun run deploy:admin:cf`
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "commission-index-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-17",
  "build": {
    "command": "bun run build:admin:cf || bun run --cwd ../.. build:admin:cf"
  },
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "preview_urls": false,
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commission-index-admin-data",
      "database_id": "c448328b-830b-455a-ab90-06a9cf95d8aa",
      "migrations_dir": "./migrations",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "commission-index-source-images",
      "remote": true
    }
  ],
  "routes": [
    {
      "pattern": "admin.crystallize.cc",
      "custom_domain": true
    }
  ]
}
