{
  "name": "nsfw-commission-neo",
  "type": "module",
  "version": "1.3.0",
  "private": true,
  "author": "Crystallize",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:web",
    "build:admin": "bun run --cwd apps/admin build",
    "build:web": "bun run --cwd apps/web build",
    "check": "bun run --cwd apps/web check",
    "clean": "rm -rf node_modules .wrangler apps/web/.astro apps/web/dist && bun i",
    "deploy": "bun run --cwd apps/web deploy",
    "dev": "bun run --cwd apps/web dev",
    "dev:admin": "bun run --cwd apps/admin dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd apps/admin-worker dev",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepare": "prek install",
    "preview": "bun run --cwd apps/web preview",
    "test": "bun run --cwd apps/web test",
    "test:changed": "bun run --cwd apps/web test:changed",
    "test:visual": "bun run --cwd apps/web test:visual",
    "test:visual:update": "bun run --cwd apps/web test:visual:update",
    "test:watch": "bun run --cwd apps/web test:watch"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tabler/icons-react": "^3.40.0",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.5",
    "better-sqlite3": "^12.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fuse.js": "^7.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@astrojs/check": "^0.9.8",
    "@astrojs/react": "^5.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@j178/prek": "^0.3.6",
    "@playwright/test": "^1.58.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.0.3",
    "eslint-plugin-better-tailwindcss": "^4.3.2",
    "jsdom": "^29.0.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.74.0"
  },
  "lint-staged": {
    "*": [
      "eslint --fix"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ]
  }
}
