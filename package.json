{
  "name": "nsfw-commission-neo",
  "type": "module",
  "version": "1.3.0",
  "private": true,
  "author": "Crystallize",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:fact-source:export": "bun run --cwd apps/admin-worker web:fact-source:export",
    "build": "bun run build:web",
    "build:admin": "bun run --cwd apps/admin build",
    "build:web": "bun run --cwd apps/web build",
    "check": "bun run --cwd apps/web check",
    "clean": "rm -rf node_modules .wrangler apps/web/.astro apps/web/dist coverage playwright-report test-results && bun i",
    "deploy": "bun run --cwd apps/web deploy",
    "dev": "bun run --cwd apps/web dev",
    "dev:admin": "bun run ./scripts/devAdminRemote.mjs",
    "dev:admin:remote": "bun run ./scripts/devAdminRemote.mjs",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:worker": "bun run --cwd apps/admin-worker dev",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepare": "prek install",
    "preview": "bun run --cwd apps/web preview",
    "test": "vitest run -c vitest.config.ts",
    "test:changed": "vitest run -c vitest.config.ts --changed",
    "test:visual": "playwright test -c playwright.config.ts",
    "test:visual:admin:legacy": "playwright test -c playwright.config.ts --project=admin-legacy",
    "test:visual:admin:legacy:update": "playwright test -c playwright.config.ts --project=admin-legacy --update-snapshots",
    "test:visual:update": "playwright test -c playwright.config.ts --update-snapshots",
    "test:watch": "vitest -c vitest.config.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@eslint-react/eslint-plugin": "^2.11.0",
    "@j178/prek": "^0.3.6",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-better-tailwindcss": "^4.3.2",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*": [
      "eslint --fix"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ]
  }
}
